{
  "manifest_version": 3,
  "name": "HCMUTE Downloader",
  "version": "1.0.3",
  "description": "Tải file PDF gốc từ thư viện số HCMUTE",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://apiuni.dlib.vn/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "HCMUTE Downloader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://thuvienso.hcmute.edu.vn/tai-lieu/*.html*",
        "*://thuvienso-hcmute.dlib.vn/tai-lieu/*.html*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
